# Description:  Frame-capture based graphics debugger for Vulkan, D3D11, D3D12, OpenGL, and OpenGL ES development
# URL:          https://renderdoc.org/
# Maintainer:   Ola Håkansson <ola dot hakansson at gmail dot com>
# Depends on:   ninja cmake qt5 python3 xorg-libx11 xorg-libxcb xorg-xcb-util-keysyms

name=renderdoc
version=1.35
release=1
source=(https://github.com/baldurk/$name/archive/refs/tags/v$version.tar.gz)

build() {

  mkdir build
  cmake -GNinja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -S $name-$version \
        -B $SRC/build

  ninja -C build -j ${JOBS:-1}
  DESTDIR=$PKG ninja -C build install

  rm -rf $PKG/usr/share/doc
}
