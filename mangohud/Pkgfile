# Description: A Vulkan and OpenGL overlay for monitoring FPS, temperatures, CPU/GPU load and more
# URL:         https://github.com/flightlessmango/MangoHud
# Maintainer:  Ola Håkansson <ola dot hakansson at gmail dot com>
# Depends on:  meson ninja glslang dbus

name=mangohud
version=0.8.2
release=1
source=(https://github.com/flightlessmango/MangoHud/archive/refs/tags/v$version.tar.gz 0001-check-HAVE_WAYLAND.patch)

build() {
  cd MangoHud-$version

  patch -p1 -i ../0001-check-HAVE_WAYLAND.patch

  prt-get isinst wayland || PKGMK_MANGOHUD+=' -Dwith_wayland=disabled'

  meson setup --buildtype release --prefix=/usr -Dwith_xnvctrl=disabled build $PKGMK_MANGOHUD
  PREFIX=/usr DESTDIR=$PKG ninja -C build install
}
