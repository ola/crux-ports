# Description: Portable cross-platform audio I/O library
# URL: http://portaudio.com
# Maintainer: Ola Håkansson <ola dot hakansson at gmail dot com>
# Depends on: alsa-lib

name=portaudio
version=19.7.0
release=1
source=(https://github.com/PortAudio/portaudio/archive/refs/tags/v$version.tar.gz)

build() {

  cd $name-$version

  autoreconf -fiv bindings/cpp
  autoreconf -fiv .

  ./configure --prefix=/usr \
              --enable-cxx
  make -j1
  make DESTDIR=$PKG install
}
