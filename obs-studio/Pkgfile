# Description: Software for video recording and live streaming
# URL: https://obsproject.com/
# Maintainer: Ola Håkansson <ola dot hakansson at gmail dot com>
# Depends on: cmake ninja v4l-utils ffmpeg mbedtls fdk-aac libgmp qt6 x264 luajit speexdsp pipewire pulseaudio libdatachannel asio simde rnnoise

name=obs-studio
version=33.0.1
release=1
browsercommit=d4db73e7e5d5b51d853177c8cddc796715a8ac84
websocketcommit=e28f84975984340e84fc4879cfc05741cc0afde1
source=(https://github.com/obsproject/$name/archive/$version.tar.gz
        https://cdn-fastly.obsproject.com/downloads/cef_binary_7871_linux_x86_64.tar.xz
        https://github.com/obsproject/obs-browser/archive/$browsercommit.zip
        https://github.com/obsproject/obs-websocket/archive/$websocketcommit.zip)

build() {
  mkdir build

  rm -r $SRC/$name-$version/plugins/obs-browser
  mv $SRC/obs-browser-$browsercommit $SRC/$name-$version/plugins/obs-browser

  rm -r $SRC/$name-$version/plugins/obs-websocket
  mv $SRC/obs-websocket-$websocketcommit $SRC/$name-$version/plugins/obs-websocket

  cmake -GNinja \
    -Wno-dev \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_FLAGS_RELEASE="$CFLAGS -Wno-error=deprecated-declarations" \
    -DOBS_VERSION_OVERRIDE="$version" \
    -DENABLE_SCRIPTING=ON \
    -DENABLE_SERVICE_UPDATES=OFF \
    -DENABLE_WAYLAND=OFF \
    -DENABLE_PIPEWIRE=ON \
    -DENABLE_PULSEAUDIO=ON \
    -DENABLE_WEBSOCKET=ON \
    -DENABLE_WEBRTC=ON \
    -DENABLE_NVENC=OFF \
    -DENABLE_RNNOISE=ON \
    -DENABLE_NEW_MPEGTS_OUTPUT=OFF \
    -DENABLE_DECKLINK=OFF \
    -DENABLE_AJA=OFF \
    -DENABLE_QSV11=OFF \
    -DENABLE_VLC=OFF \
    -DENABLE_WHATSNEW=OFF \
    -DENABLE_LIBFDK=ON \
    -DENABLE_BROWSER=ON \
    -DCEF_ROOT_DIR=$SRC/cef_binary_7871_linux_x86_64 \
    -S $name-$version -B build

  ninja -C build -j ${JOBS:-1}
  DESTDIR=$PKG ninja -C build install

  rm -r $PKG/usr/share/obs/obs-studio/authors/AUTHORS

  find $PKG/usr/share/obs \
       -iname '*ini' \
       ! -iname 'en-*.ini' \
       ! -iname 'locale.ini' \
       -exec rm '{}' \+

  find $PKG/usr/lib64/obs-modules \
       -iname '*pak' \
       ! -iname 'en-*.pak' \
       -exec rm '{}' \+
}
